+  original.snapshot = { threadId: "native-thread-original", phase: "running", messages: [] };
+  steveChat.write(original);
+  const packets = [];
+  const apiCalls = [];
+  const h = harness([], async url => { apiCalls.push(url); return {}; }, {
+    steveChat, cadEngine: "render",
+    onSendSteveDesignMessage: async packet => { packets.push(packet); return { ok: true }; },
+  });
+  h.chat.renderDesignChat(h.host);
+  assert.equal(h["send-as-is"].hidden, true);
+  h.setCadEngine("jake");
