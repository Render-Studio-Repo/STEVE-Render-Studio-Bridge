+    ({userId, projectId, replyToRequestId, prompt})))), [{ userId: "user", projectId: "project-a",
+    replyToRequestId: "request-origin", prompt: "Continue the original conversation" }]);
+  assert.deepEqual(apiCalls, []);
+  h.setProject("project-b");
+  h.chat.renderDesignChat(h.host);
+  assert.equal(h["send-as-is"].hidden, false);
+  assert.equal(h.submit.textContent, "Keep refining");
+  h.setProject("project-a");
+  h.setUser("someone-else");
+  h.chat.renderDesignChat(h.host);
+  assert.equal(h["send-as-is"].hidden, false);
+});
