+  const h = harness([], async () => ({}), { steveChat, cadEngine: "render",
+    onSendSteveDesignMessage: packet => {
+      packets.push(packet);
+      return packets.length === 1 ? new Promise(resolve => { finishFirst = resolve; }) : Promise.resolve({ ok: true });
