+test("a queued STEVE record without a thread replies to the previous linked request", async () => {
+  const steveChat = new SteveDesignChat({ storage: { length: 0 } });
+  const owner = { userId: "user", projectId: "project-a" };
+  const linked = steveChat.remember(owner, "request-linked", "Original request");
+  linked.snapshot = { phase: "running", threadId: "native-thread-original", messages: [] };
+  steveChat.write(linked);
+  const queued = steveChat.remember(owner, "request-queued", "Queued continuation");
+  queued.snapshot = { phase: "queued", messages: [] };
+  steveChat.write(queued);
+  const rejected = steveChat.remember(owner, "request-rejected", "Rejected request");
+  rejected.snapshot = { threadId: "native-thread-rejected", messages: [] };
+  rejected.rejected = true;
+  steveChat.write(rejected);
+  const packets = [];
+  const h = harness([], async () => ({}), { steveChat, cadEngine: "render",
+    onSendSteveDesignMessage: async packet => { packets.push(packet); return { ok: true }; } });
+  await h.chat.sendDesignChat(h.host, "Another reply while queued");
+  assert.equal(packets[0].replyToRequestId, "request-linked");
+  assert.equal(packets[0].userId, "user");
+  assert.equal(packets[0].projectId, "project-a");
+  queued.snapshot.threadId = "native-thread-original";
+  steveChat.write(queued);
+  await h.chat.sendDesignChat(h.host, "Reply after the queued request links");
+  assert.equal(packets[1].replyToRequestId, "request-queued");
+  assert.equal(h["send-as-is"].hidden, true);
+});
